---
interface Props {
  code?: string;
}
const { code } = Astro.props;
---
<div class="bc-mermaid-wrapper">
  <pre class="mermaid">{code ? code : <slot />}</pre>
</div>

<style>
  .bc-mermaid-wrapper {
    margin: var(--bc-space-4) 0;
    padding: var(--bc-space-4);
    background: var(--bc-surface);
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-md);
    overflow-x: auto;
    text-align: center;
  }
</style>
