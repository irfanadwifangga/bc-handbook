---
---
<figure class="bc-ecosystem-diagram-wrapper" aria-label="Diagram Perputaran Kerja Ekosistem Business Central">
  <div class="bc-diagram-header">
    <span class="bc-diagram-title">Peta Alur Kerja Ekosistem Dynamics 365 Business Central</span>
  </div>

  <div class="bc-ecosystem-diagram-viewport">
    <svg
      viewBox="0 0 1020 640"
      xmlns="http://www.w3.org/2000/svg"
      class="bc-ecosystem-svg"
      role="img"
      aria-labelledby="bc-eco-title bc-eco-desc"
    >
      <title id="bc-eco-title">Diagram Alur Ekosistem Dynamics 365 Business Central</title>
      <desc id="bc-eco-desc">Diagram visual terpadu siklus bisnis: dari master data, pengadaan, persediaan fisik, penjualan, kas dan bank, hingga buku besar dan integrasi.</desc>

      <defs>
        <!-- Penanda Panah Berwarna -->
        <marker id="arr-accent" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-accent)" />
        </marker>
        <marker id="arr-muted" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-text-muted)" />
        </marker>
        <marker id="arr-info" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-info)" />
        </marker>
      </defs>

      <!-- ================= JALUR KONEKSI LEGA (BEBAS TABRAKAN) ================= -->

      <!-- 1. Master Data turun ke 3 Modul Operasional -->
      <path d="M 350 100 L 170 100 L 170 145" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#arr-muted)" />
      <path d="M 510 100 L 510 145" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#arr-muted)" />
      <path d="M 670 100 L 850 100 L 850 145" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#arr-muted)" />

      <!-- 2. Alur Fisik: Purchasing -> Inventory -> Sales (Gap 80px) -->
      <path d="M 300 205 L 375 205" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />
      <path d="M 640 205 L 715 205" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 3. Purchasing turun ke Cash & Bank (Bayar Utang Vendor) -->
      <path d="M 170 265 L 170 325" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 4. Sales turun langsung ke General Ledger (Faktur Jual & Revenue) -->
      <path d="M 850 265 L 850 325" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 5. Sales masuk ke Cash & Bank (Pelunasan Piutang) -->
      <path d="M 740 265 L 740 295 L 390 295 L 390 325" stroke="var(--bc-accent)" stroke-width="2" fill="none" marker-end="url(#arr-accent)" />

      <!-- 6. Inventory turun ke General Ledger (Valuasi & COGS) -->
      <path d="M 510 265 L 510 295 L 630 295 L 630 325" stroke="var(--bc-accent)" stroke-width="2" stroke-dasharray="5 3" fill="none" marker-end="url(#arr-accent)" />

      <!-- 7. Cash & Bank masuk ke General Ledger (Jurnal Kas & Mutasi, Gap 80px) -->
      <path d="M 470 390 L 545 390" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 8. Ekosistem Integrasi menopang Finansial & Operasional -->
      <path d="M 280 515 L 280 455" stroke="var(--bc-info)" stroke-width="2" fill="none" marker-end="url(#arr-info)" />
      <path d="M 740 515 L 740 455" stroke="var(--bc-info)" stroke-width="2" fill="none" marker-end="url(#arr-info)" />

      <!-- ================= LABEL ALUR TERPISAH DENGAN LEGA ================= -->

      <!-- Label P2P -> Inventory (di atas panah, gap 80px) -->
      <g transform="translate(322, 180)">
        <rect width="36" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="18" y="13" text-anchor="middle" class="bc-flow-pill-text">+Qty</text>
      </g>

      <!-- Label Inventory -> Sales (di atas panah, gap 80px) -->
      <g transform="translate(662, 180)">
        <rect width="36" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="18" y="13" text-anchor="middle" class="bc-flow-pill-text">-Qty</text>
      </g>

      <!-- Label Purchasing -> Cash -->
      <g transform="translate(90, 285)">
        <rect width="140" height="20" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="70" y="14" text-anchor="middle" class="bc-flow-pill-text">Bayar Utang Vendor</text>
      </g>

      <!-- Label Sales -> Cash -->
      <g transform="translate(485, 285)">
        <rect width="150" height="20" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="75" y="14" text-anchor="middle" class="bc-flow-pill-text">Pelunasan Piutang</text>
      </g>

      <!-- Label Cash -> GL (di atas panah, gap 80px) -->
      <g transform="translate(485, 365)">
        <rect width="50" height="20" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="25" y="14" text-anchor="middle" class="bc-flow-pill-text">Jurnal</text>
      </g>

      <!-- ================= KARTU TAHAPAN (NODES) ================= -->

      <!-- TINGKAT 1: MASTER DATA (Fondasi Atas) -->
      <g class="bc-node-group" transform="translate(280, 15)">
        <rect width="460" height="85" rx="8" class="bc-node-rect" />
        <rect width="460" height="4" rx="2" fill="var(--bc-text-muted)" />
        <text x="230" y="30" text-anchor="middle" class="bc-node-title">1. Setup & Master Data</text>
        <text x="230" y="52" text-anchor="middle" class="bc-node-subtitle">Chart of Accounts • Posting Groups • Item • Vendor • Customer • Bank</text>
        <text x="230" y="70" text-anchor="middle" class="bc-node-badge">Fondasi Aturan Akuntansi & Master Data Acuan</text>
      </g>

      <!-- TINGKAT 2: RANTAI OPERASIONAL UTAMA (Purchasing -> Inventory -> Sales) -->
      <!-- 2. Purchasing -->
      <g class="bc-node-group" transform="translate(40, 150)">
        <rect width="260" height="115" rx="8" class="bc-node-rect" />
        <rect width="260" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="130" y="30" text-anchor="middle" class="bc-node-title">2. Purchasing (P2P)</text>
        <text x="130" y="52" text-anchor="middle" class="bc-node-subtitle">Purchase Order → Receive & Invoice</text>
        <text x="130" y="74" text-anchor="middle" class="bc-node-badge">Vendor Ledger Entry</text>
        <text x="130" y="94" text-anchor="middle" class="bc-node-subdetail">+Kuantitas Stok & Utang Usaha (A/P)</text>
      </g>

      <!-- 3. Inventory -->
      <g class="bc-node-group" transform="translate(380, 150)">
        <rect width="260" height="115" rx="8" class="bc-node-rect" />
        <rect width="260" height="4" rx="2" fill="var(--bc-warning, #f59e0b)" />
        <text x="130" y="30" text-anchor="middle" class="bc-node-title">3. Inventory & Costing</text>
        <text x="130" y="52" text-anchor="middle" class="bc-node-subtitle">Stok Gudang, Lokasi & Nilai Modal</text>
        <text x="130" y="74" text-anchor="middle" class="bc-node-badge">Item & Value Entries</text>
        <text x="130" y="94" text-anchor="middle" class="bc-node-subdetail">Valuasi FIFO / Cost Adjustment</text>
      </g>

      <!-- 4. Sales -->
      <g class="bc-node-group" transform="translate(720, 150)">
        <rect width="260" height="115" rx="8" class="bc-node-rect" />
        <rect width="260" height="4" rx="2" fill="var(--bc-success, #10b981)" />
        <text x="130" y="30" text-anchor="middle" class="bc-node-title">4. Sales (O2C)</text>
        <text x="130" y="52" text-anchor="middle" class="bc-node-subtitle">Sales Order → Ship & Invoice</text>
        <text x="130" y="74" text-anchor="middle" class="bc-node-badge">Customer Ledger Entry</text>
        <text x="130" y="94" text-anchor="middle" class="bc-node-subdetail">-Kuantitas Stok & Piutang Usaha (A/R)</text>
      </g>

      <!-- TINGKAT 3: PUSAT KEUANGAN & AUDIT -->
      <!-- 5. Cash & Bank -->
      <g class="bc-node-group" transform="translate(90, 330)">
        <rect width="380" height="120" rx="8" class="bc-node-rect" />
        <rect width="380" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="190" y="30" text-anchor="middle" class="bc-node-title">5. Cash & Bank Management</text>
        <text x="190" y="52" text-anchor="middle" class="bc-node-subtitle">Payment & Cash Receipt Journals • Bank Rec.</text>
        <text x="190" y="74" text-anchor="middle" class="bc-node-badge">Bank Acc. Ledger • Apply Invoices</text>
        <text x="190" y="94" text-anchor="middle" class="bc-node-subdetail">Pelunasan Utang/Piutang & Pencocokan Rekening Koran</text>
      </g>

      <!-- 6. General Ledger -->
      <g class="bc-node-group" transform="translate(550, 330)">
        <rect width="380" height="120" rx="8" class="bc-node-rect" />
        <rect width="380" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="190" y="30" text-anchor="middle" class="bc-node-title">6. General Ledger & Reporting</text>
        <text x="190" y="52" text-anchor="middle" class="bc-node-subtitle">Chart of Accounts • G/L Entries • G/L Register</text>
        <text x="190" y="74" text-anchor="middle" class="bc-node-badge">Financial Reports (Neraca & Laba Rugi)</text>
        <text x="190" y="94" text-anchor="middle" class="bc-node-subdetail">Audit Trail Terpadu (Debit = Kredit Otomatis)</text>
      </g>

      <!-- TINGKAT 4: INTEGRASI & EXTENSIBILITY -->
      <!-- 7. Integrasi -->
      <g class="bc-node-group" transform="translate(70, 515)">
        <rect width="880" height="85" rx="8" class="bc-node-rect" />
        <rect width="880" height="4" rx="2" fill="var(--bc-info)" />
        <text x="440" y="28" text-anchor="middle" class="bc-node-title">7. Ekosistem Integrasi & Extensibility</text>
        <text x="440" y="50" text-anchor="middle" class="bc-node-subtitle">Standard APIs (v2.0) • Custom API Pages • Webhooks • Power Automate • Per-Tenant Extension (AL)</text>
        <text x="440" y="68" text-anchor="middle" class="bc-node-badge">Sinkronisasi Data Real-time & Pertukaran Data Pihak Ketiga</text>
      </g>
    </svg>
  </div>

  <figcaption class="bc-ecosystem-caption">
    Diagram Hubungan Modul Operasional, Ledger Entries, Buku Besar (G/L), dan Ekosistem Integrasi Dynamics 365 Business Central.
  </figcaption>
</figure>

<style>
  .bc-ecosystem-diagram-wrapper {
    margin: var(--bc-space-4) 0;
    padding: var(--bc-space-4);
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-md);
    background: var(--bc-surface);
  }
  .bc-diagram-header {
    margin-bottom: var(--bc-space-3);
    padding-bottom: var(--bc-space-2);
    border-bottom: var(--bc-border-width) solid var(--bc-border);
  }
  .bc-diagram-title {
    font-size: var(--bc-text-xs);
    font-weight: 600;
    color: var(--bc-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .bc-ecosystem-diagram-viewport {
    width: 100%;
    overflow: hidden;
  }
  .bc-ecosystem-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--bc-font-sans);
  }
  .bc-node-rect {
    fill: var(--bc-surface-2);
    stroke: var(--bc-border);
    stroke-width: 1.5;
    transition: stroke 0.15s ease, fill 0.15s ease;
  }
  .bc-node-group:hover .bc-node-rect {
    stroke: var(--bc-accent);
  }
  .bc-node-title {
    font-size: 15px;
    font-weight: 700;
    fill: var(--bc-text);
  }
  .bc-node-subtitle {
    font-size: 12px;
    fill: var(--bc-text-muted);
  }
  .bc-node-subdetail {
    font-size: 11px;
    fill: var(--bc-text-muted);
  }
  .bc-node-badge {
    font-size: 11px;
    font-weight: 600;
    fill: var(--bc-accent);
  }
  .bc-flow-pill-text {
    font-size: 11px;
    font-weight: 600;
    fill: var(--bc-text);
  }
  .bc-ecosystem-caption {
    margin-top: var(--bc-space-3);
    text-align: center;
    font-size: var(--bc-text-xs);
    color: var(--bc-text-muted);
  }
</style>
