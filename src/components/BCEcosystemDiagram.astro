---
---
<figure class="bc-ecosystem-diagram-wrapper" aria-label="Diagram Perputaran Kerja Ekosistem Business Central">
  <div class="bc-ecosystem-diagram-viewport">
    <svg
      viewBox="0 0 920 500"
      xmlns="http://www.w3.org/2000/svg"
      class="bc-ecosystem-svg"
      role="img"
      aria-labelledby="bc-eco-title bc-eco-desc"
    >
      <title id="bc-eco-title">Diagram Alur Ekosistem Dynamics 365 Business Central</title>
      <desc id="bc-eco-desc">Diagram visual bertingkat (Swimlane) alur kerja terpadu dari master data, pengadaan, persediaan, penjualan, kas dan bank, hingga buku besar dan integrasi.</desc>

      <defs>
        <!-- Panah Berwarna -->
        <marker id="arr-accent" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-accent)" />
        </marker>
        <marker id="arr-muted" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-text-muted)" />
        </marker>
        <marker id="arr-info" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-info)" />
        </marker>
      </defs>

      <!-- ================= JALUR KONEKSI BERSIH (TANPA SILANG) ================= -->

      <!-- 1. Master Data turun ke 3 Modul Operasional -->
      <path d="M 320 85 L 160 85 L 160 125" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="4 4" fill="none" marker-end="url(#arr-muted)" />
      <path d="M 460 85 L 460 125" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="4 4" fill="none" marker-end="url(#arr-muted)" />
      <path d="M 600 85 L 760 85 L 760 125" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="4 4" fill="none" marker-end="url(#arr-muted)" />

      <!-- 2. Alur Fisik Barang: Purchasing -> Inventory -> Sales -->
      <path d="M 290 175 L 320 175" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />
      <path d="M 600 175 L 630 175" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 3. Purchasing turun ke Cash & Bank (Bayar Utang Vendor) -->
      <path d="M 160 220 L 160 270" stroke="var(--bc-accent)" stroke-width="2" fill="none" marker-end="url(#arr-accent)" />

      <!-- 4. Sales turun ke Cash & Bank (Terima Pelunasan Piutang) -->
      <path d="M 690 220 L 690 248 L 360 248 L 360 270" stroke="var(--bc-accent)" stroke-width="2" fill="none" marker-end="url(#arr-accent)" />

      <!-- 5. Inventory turun ke General Ledger (Valuasi & COGS) -->
      <path d="M 460 220 L 460 252 L 560 252 L 560 270" stroke="var(--bc-accent)" stroke-width="2" stroke-dasharray="4 3" fill="none" marker-end="url(#arr-accent)" />

      <!-- 6. Sales turun langsung ke General Ledger (Faktur Jual & Revenue) -->
      <path d="M 800 220 L 800 270" stroke="var(--bc-accent)" stroke-width="2" fill="none" marker-end="url(#arr-accent)" />

      <!-- 7. Cash & Bank masuk ke General Ledger (Jurnal Kas & Mutasi) -->
      <path d="M 430 320 L 470 320" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 8. Ekosistem Integrasi menopang Operasional & Finansial -->
      <path d="M 245 410 L 245 375" stroke="var(--bc-info)" stroke-width="2" fill="none" marker-end="url(#arr-info)" />
      <path d="M 675 410 L 675 375" stroke="var(--bc-info)" stroke-width="2" fill="none" marker-end="url(#arr-info)" />

      <!-- ================= LABEL ALUR PERPINDAHAN ================= -->

      <!-- Label P2P -> Inventory -->
      <g transform="translate(293, 155)">
        <rect width="30" height="16" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="15" y="11" text-anchor="middle" class="bc-flow-pill-text">+Qty</text>
      </g>

      <!-- Label Inventory -> Sales -->
      <g transform="translate(603, 155)">
        <rect width="30" height="16" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="15" y="11" text-anchor="middle" class="bc-flow-pill-text">-Qty</text>
      </g>

      <!-- Label Purchasing -> Cash -->
      <g transform="translate(90, 235)">
        <rect width="140" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="70" y="12" text-anchor="middle" class="bc-flow-pill-text">Bayar Utang Vendor</text>
      </g>

      <!-- Label Sales -> Cash -->
      <g transform="translate(435, 239)">
        <rect width="150" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="75" y="12" text-anchor="middle" class="bc-flow-pill-text">Terima Piutang Customer</text>
      </g>

      <!-- Label Cash -> GL -->
      <g transform="translate(433, 305)">
        <rect width="34" height="16" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="17" y="11" text-anchor="middle" class="bc-flow-pill-text">Jurnal</text>
      </g>

      <!-- ================= KARTU TAHAPAN (NODES) ================= -->

      <!-- TINGKAT 1: MASTER DATA (Fondasi Atas) -->
      <g class="bc-node-group" transform="translate(260, 10)">
        <rect width="400" height="75" rx="8" class="bc-node-rect" />
        <rect width="400" height="4" rx="2" fill="var(--bc-text-muted)" />
        <text x="200" y="27" text-anchor="middle" class="bc-node-title">1. Setup & Master Data</text>
        <text x="200" y="47" text-anchor="middle" class="bc-node-subtitle">Chart of Accounts • Posting Groups • Item • Vendor • Customer • Bank</text>
        <text x="200" y="64" text-anchor="middle" class="bc-node-badge">Fondasi Aturan Akuntansi & Profil Master</text>
      </g>

      <!-- TINGKAT 2: RANTAI OPERASIONAL UTAMA -->
      <!-- 2. Purchasing -->
      <g class="bc-node-group" transform="translate(30, 130)">
        <rect width="260" height="90" rx="8" class="bc-node-rect" />
        <rect width="260" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="130" y="28" text-anchor="middle" class="bc-node-title">2. Purchasing (P2P)</text>
        <text x="130" y="48" text-anchor="middle" class="bc-node-subtitle">Purchase Order → Receive & Invoice</text>
        <text x="130" y="65" text-anchor="middle" class="bc-node-badge">Vendor Ledger Entry</text>
        <text x="130" y="79" text-anchor="middle" class="bc-node-subdetail">+Kuantitas Stok & Utang Usaha</text>
      </g>

      <!-- 3. Inventory -->
      <g class="bc-node-group" transform="translate(330, 130)">
        <rect width="260" height="90" rx="8" class="bc-node-rect" />
        <rect width="260" height="4" rx="2" fill="var(--bc-warning, #f59e0b)" />
        <text x="130" y="28" text-anchor="middle" class="bc-node-title">3. Inventory & Costing</text>
        <text x="130" y="48" text-anchor="middle" class="bc-node-subtitle">Stok Gudang, Lokasi & Nilai Modal</text>
        <text x="130" y="65" text-anchor="middle" class="bc-node-badge">Item & Value Entries</text>
        <text x="130" y="79" text-anchor="middle" class="bc-node-subdetail">Valuasi FIFO / Cost Adjustment</text>
      </g>

      <!-- 4. Sales -->
      <g class="bc-node-group" transform="translate(630, 130)">
        <rect width="260" height="90" rx="8" class="bc-node-rect" />
        <rect width="260" height="4" rx="2" fill="var(--bc-success, #10b981)" />
        <text x="130" y="28" text-anchor="middle" class="bc-node-title">4. Sales (O2C)</text>
        <text x="130" y="48" text-anchor="middle" class="bc-node-subtitle">Sales Order → Ship & Invoice</text>
        <text x="130" y="65" text-anchor="middle" class="bc-node-badge">Customer Ledger Entry</text>
        <text x="130" y="79" text-anchor="middle" class="bc-node-subdetail">-Kuantitas Stok & Piutang Usaha</text>
      </g>

      <!-- TINGKAT 3: PUSAT KEUANGAN & AUDIT -->
      <!-- 5. Cash & Bank -->
      <g class="bc-node-group" transform="translate(60, 275)">
        <rect width="370" height="95" rx="8" class="bc-node-rect" />
        <rect width="370" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="185" y="28" text-anchor="middle" class="bc-node-title">5. Cash & Bank Management</text>
        <text x="185" y="48" text-anchor="middle" class="bc-node-subtitle">Payment & Cash Receipt Journals • Bank Reconciliation</text>
        <text x="185" y="66" text-anchor="middle" class="bc-node-badge">Bank Acc. Ledger • Apply Invoices</text>
        <text x="185" y="82" text-anchor="middle" class="bc-node-subdetail">Pelunasan Utang/Piutang & Pencocokan Rekening Koran</text>
      </g>

      <!-- 6. General Ledger -->
      <g class="bc-node-group" transform="translate(490, 275)">
        <rect width="370" height="95" rx="8" class="bc-node-rect" />
        <rect width="370" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="185" y="28" text-anchor="middle" class="bc-node-title">6. General Ledger & Reporting</text>
        <text x="185" y="48" text-anchor="middle" class="bc-node-subtitle">Chart of Accounts • G/L Entries • G/L Register (Immutable)</text>
        <text x="185" y="66" text-anchor="middle" class="bc-node-badge">Financial Reports</text>
        <text x="185" y="82" text-anchor="middle" class="bc-node-subdetail">Neraca Saldo, Laba Rugi, & Audit Trail Terpadu</text>
      </g>

      <!-- TINGKAT 4: INTEGRASI & EXTENSIBILITY -->
      <!-- 7. Integrasi -->
      <g class="bc-node-group" transform="translate(60, 415)">
        <rect width="800" height="75" rx="8" class="bc-node-rect" />
        <rect width="800" height="4" rx="2" fill="var(--bc-info)" />
        <text x="400" y="27" text-anchor="middle" class="bc-node-title">7. Ekosistem Integrasi & Extensibility</text>
        <text x="400" y="47" text-anchor="middle" class="bc-node-subtitle">Standard APIs (v2.0) • Custom API Pages • Webhooks • Power Automate • Per-Tenant Extension (AL)</text>
        <text x="400" y="64" text-anchor="middle" class="bc-node-badge">Sinkronisasi Data Real-time & Pertukaran Data Pihak Ketiga</text>
      </g>
    </svg>
  </div>
  <figcaption class="bc-ecosystem-caption">
    Diagram Perputaran Ekosistem Business Central: Dari Fondasi Master Data, Rantai Operasional (P2P → Stok → O2C), Pusat Finansial, hingga Integrasi Eksternal.
  </figcaption>
</figure>

<style>
  .bc-ecosystem-diagram-wrapper {
    margin: var(--bc-space-4) 0;
    padding: var(--bc-space-4);
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-md);
    background: var(--bc-surface);
  }
  .bc-ecosystem-diagram-viewport {
    width: 100%;
    overflow: hidden;
  }
  .bc-ecosystem-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--bc-font-sans);
  }
  .bc-node-rect {
    fill: var(--bc-surface-2);
    stroke: var(--bc-border);
    stroke-width: 1.5;
    transition: stroke 0.15s ease, fill 0.15s ease;
  }
  .bc-node-group:hover .bc-node-rect {
    stroke: var(--bc-accent);
  }
  .bc-node-title {
    font-size: 14px;
    font-weight: 600;
    fill: var(--bc-text);
  }
  .bc-node-subtitle {
    font-size: 11px;
    fill: var(--bc-text-muted);
  }
  .bc-node-subdetail {
    font-size: 10px;
    fill: var(--bc-text-muted);
  }
  .bc-node-badge {
    font-size: 11px;
    font-weight: 600;
    fill: var(--bc-accent);
  }
  .bc-flow-pill-text {
    font-size: 10px;
    font-weight: 600;
    fill: var(--bc-text);
  }
  .bc-ecosystem-caption {
    margin-top: var(--bc-space-3);
    text-align: center;
    font-size: var(--bc-text-xs);
    color: var(--bc-text-muted);
  }
  @media (max-width: 48rem) {
    .bc-ecosystem-diagram-viewport {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .bc-ecosystem-svg {
      min-width: 720px;
    }
  }
</style>
