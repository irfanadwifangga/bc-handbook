---
---
<figure class="bc-ecosystem-diagram-wrapper" aria-label="Diagram Perputaran Kerja Ekosistem Business Central">
  <div class="bc-diagram-toolbar">
    <span class="bc-diagram-tag">Arsitektur End-to-End Business Central</span>
    <div class="bc-diagram-actions">
      <button type="button" class="bc-diagram-tool-btn" id="bc-zoom-in" title="Perbesar">+</button>
      <button type="button" class="bc-diagram-tool-btn" id="bc-zoom-out" title="Perkecil">−</button>
      <button type="button" class="bc-diagram-tool-btn" id="bc-zoom-reset" title="Reset Zoom">↺</button>
      <button type="button" class="bc-diagram-expand-btn" id="bc-open-diag-btn" aria-haspopup="dialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        Layar Penuh
      </button>
    </div>
  </div>

  <div class="bc-ecosystem-diagram-viewport">
    <svg
      viewBox="0 0 940 660"
      xmlns="http://www.w3.org/2000/svg"
      class="bc-ecosystem-svg"
      role="img"
      aria-labelledby="bc-eco-title bc-eco-desc"
    >
      <title id="bc-eco-title">Diagram Alur Ekosistem Dynamics 365 Business Central</title>
      <desc id="bc-eco-desc">Diagram visual bertingkat (Swimlane) alur kerja terpadu dari master data, pengadaan, persediaan, penjualan, kas dan bank, hingga buku besar dan integrasi.</desc>

      <defs>
        <!-- Panah Berwarna -->
        <marker id="arr-accent" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-accent)" />
        </marker>
        <marker id="arr-muted" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-text-muted)" />
        </marker>
        <marker id="arr-info" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--bc-info)" />
        </marker>
      </defs>

      <!-- ================= JALUR KONEKSI BERSIH (TANPA SILANG) ================= -->

      <!-- 1. Master Data turun ke 3 Modul Operasional -->
      <path d="M 320 105 L 165 105 L 165 160" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#arr-muted)" />
      <path d="M 470 105 L 470 160" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#arr-muted)" />
      <path d="M 620 105 L 775 105 L 775 160" stroke="var(--bc-text-muted)" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#arr-muted)" />

      <!-- 2. Alur Fisik Barang: Purchasing -> Inventory -> Sales -->
      <path d="M 300 225 L 330 225" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />
      <path d="M 605 225 L 635 225" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 3. Purchasing turun ke Cash & Bank (Bayar Utang Vendor) -->
      <path d="M 165 290 L 165 345" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 4. Sales turun ke Cash & Bank (Terima Pelunasan Piutang) -->
      <path d="M 710 290 L 710 320 L 370 320 L 370 345" stroke="var(--bc-accent)" stroke-width="2" fill="none" marker-end="url(#arr-accent)" />

      <!-- 5. Inventory turun ke General Ledger (Valuasi & COGS) -->
      <path d="M 470 290 L 470 325 L 570 325 L 570 345" stroke="var(--bc-accent)" stroke-width="2" stroke-dasharray="5 3" fill="none" marker-end="url(#arr-accent)" />

      <!-- 6. Sales turun langsung ke General Ledger (Faktur Jual & Revenue) -->
      <path d="M 830 290 L 830 345" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 7. Cash & Bank masuk ke General Ledger (Jurnal Kas & Mutasi) -->
      <path d="M 440 410 L 495 410" stroke="var(--bc-accent)" stroke-width="2.5" fill="none" marker-end="url(#arr-accent)" />

      <!-- 8. Ekosistem Integrasi menopang Operasional & Finansial -->
      <path d="M 250 530 L 250 480" stroke="var(--bc-info)" stroke-width="2" fill="none" marker-end="url(#arr-info)" />
      <path d="M 690 530 L 690 480" stroke="var(--bc-info)" stroke-width="2" fill="none" marker-end="url(#arr-info)" />

      <!-- ================= LABEL ALUR PERPINDAHAN ================= -->

      <!-- Label P2P -> Inventory -->
      <g transform="translate(303, 205)">
        <rect width="32" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="16" y="13" text-anchor="middle" class="bc-flow-pill-text">+Qty</text>
      </g>

      <!-- Label Inventory -> Sales -->
      <g transform="translate(608, 205)">
        <rect width="32" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="16" y="13" text-anchor="middle" class="bc-flow-pill-text">-Qty</text>
      </g>

      <!-- Label Purchasing -> Cash -->
      <g transform="translate(90, 308)">
        <rect width="150" height="20" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="75" y="14" text-anchor="middle" class="bc-flow-pill-text">Bayar Utang Vendor</text>
      </g>

      <!-- Label Sales -> Cash -->
      <g transform="translate(440, 310)">
        <rect width="160" height="20" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="80" y="14" text-anchor="middle" class="bc-flow-pill-text">Terima Piutang Customer</text>
      </g>

      <!-- Label Cash -> GL -->
      <g transform="translate(447, 395)">
        <rect width="40" height="18" rx="4" fill="var(--bc-surface-2)" stroke="var(--bc-border)" />
        <text x="20" y="13" text-anchor="middle" class="bc-flow-pill-text">Jurnal</text>
      </g>

      <!-- ================= KARTU TAHAPAN (NODES) ================= -->

      <!-- TINGKAT 1: MASTER DATA (Fondasi Atas) -->
      <g class="bc-node-group" transform="translate(240, 15)">
        <rect width="460" height="90" rx="8" class="bc-node-rect" />
        <rect width="460" height="4" rx="2" fill="var(--bc-text-muted)" />
        <text x="230" y="32" text-anchor="middle" class="bc-node-title">1. Setup & Master Data</text>
        <text x="230" y="55" text-anchor="middle" class="bc-node-subtitle">Chart of Accounts • Posting Groups • Item • Vendor • Customer • Bank</text>
        <text x="230" y="75" text-anchor="middle" class="bc-node-badge">Fondasi Aturan Akuntansi & Master Data Acuan</text>
      </g>

      <!-- TINGKAT 2: RANTAI OPERASIONAL UTAMA -->
      <!-- 2. Purchasing -->
      <g class="bc-node-group" transform="translate(30, 165)">
        <rect width="270" height="125" rx="8" class="bc-node-rect" />
        <rect width="270" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="135" y="32" text-anchor="middle" class="bc-node-title">2. Purchasing (P2P)</text>
        <text x="135" y="56" text-anchor="middle" class="bc-node-subtitle">Purchase Order → Receive & Invoice</text>
        <text x="135" y="80" text-anchor="middle" class="bc-node-badge">Vendor Ledger Entry</text>
        <text x="135" y="102" text-anchor="middle" class="bc-node-subdetail">+Kuantitas Stok & Utang Usaha (A/P)</text>
      </g>

      <!-- 3. Inventory -->
      <g class="bc-node-group" transform="translate(335, 165)">
        <rect width="270" height="125" rx="8" class="bc-node-rect" />
        <rect width="270" height="4" rx="2" fill="var(--bc-warning, #f59e0b)" />
        <text x="135" y="32" text-anchor="middle" class="bc-node-title">3. Inventory & Costing</text>
        <text x="135" y="56" text-anchor="middle" class="bc-node-subtitle">Stok Gudang, Lokasi & Nilai Modal</text>
        <text x="135" y="80" text-anchor="middle" class="bc-node-badge">Item & Value Entries</text>
        <text x="135" y="102" text-anchor="middle" class="bc-node-subdetail">Valuasi FIFO / Cost Adjustment</text>
      </g>

      <!-- 4. Sales -->
      <g class="bc-node-group" transform="translate(640, 165)">
        <rect width="270" height="125" rx="8" class="bc-node-rect" />
        <rect width="270" height="4" rx="2" fill="var(--bc-success, #10b981)" />
        <text x="135" y="32" text-anchor="middle" class="bc-node-title">4. Sales (O2C)</text>
        <text x="135" y="56" text-anchor="middle" class="bc-node-subtitle">Sales Order → Ship & Invoice</text>
        <text x="135" y="80" text-anchor="middle" class="bc-node-badge">Customer Ledger Entry</text>
        <text x="135" y="102" text-anchor="middle" class="bc-node-subdetail">-Kuantitas Stok & Piutang Usaha (A/R)</text>
      </g>

      <!-- TINGKAT 3: PUSAT KEUANGAN & AUDIT -->
      <!-- 5. Cash & Bank -->
      <g class="bc-node-group" transform="translate(60, 350)">
        <rect width="380" height="125" rx="8" class="bc-node-rect" />
        <rect width="380" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="190" y="32" text-anchor="middle" class="bc-node-title">5. Cash & Bank Management</text>
        <text x="190" y="56" text-anchor="middle" class="bc-node-subtitle">Payment & Cash Receipt Journals • Bank Rec.</text>
        <text x="190" y="80" text-anchor="middle" class="bc-node-badge">Bank Acc. Ledger • Apply Invoices</text>
        <text x="190" y="102" text-anchor="middle" class="bc-node-subdetail">Pelunasan Utang/Piutang & Pencocokan Rekening Koran</text>
      </g>

      <!-- 6. General Ledger -->
      <g class="bc-node-group" transform="translate(500, 350)">
        <rect width="380" height="125" rx="8" class="bc-node-rect" />
        <rect width="380" height="4" rx="2" fill="var(--bc-accent)" />
        <text x="190" y="32" text-anchor="middle" class="bc-node-title">6. General Ledger & Reporting</text>
        <text x="190" y="56" text-anchor="middle" class="bc-node-subtitle">Chart of Accounts • G/L Entries • G/L Register</text>
        <text x="190" y="80" text-anchor="middle" class="bc-node-badge">Financial Reports (Neraca & Laba Rugi)</text>
        <text x="190" y="102" text-anchor="middle" class="bc-node-subdetail">Audit Trail Terpadu (Debit = Kredit Otomatis)</text>
      </g>

      <!-- TINGKAT 4: INTEGRASI & EXTENSIBILITY -->
      <!-- 7. Integrasi -->
      <g class="bc-node-group" transform="translate(60, 535)">
        <rect width="820" height="95" rx="8" class="bc-node-rect" />
        <rect width="820" height="4" rx="2" fill="var(--bc-info)" />
        <text x="410" y="30" text-anchor="middle" class="bc-node-title">7. Ekosistem Integrasi & Extensibility</text>
        <text x="410" y="54" text-anchor="middle" class="bc-node-subtitle">Standard APIs (v2.0) • Custom API Pages • Webhooks • Power Automate • Per-Tenant Extension (AL)</text>
        <text x="410" y="74" text-anchor="middle" class="bc-node-badge">Sinkronisasi Data Real-time & Pertukaran Data Pihak Ketiga</text>
      </g>
    </svg>
  </div>

  <figcaption class="bc-ecosystem-caption">
    Diagram Perputaran Ekosistem Business Central: Dari Fondasi Master Data, Rantai Operasional (P2P → Stok → O2C), Pusat Finansial, hingga Integrasi Eksternal.
  </figcaption>

  <!-- Modal Layar Penuh -->
  <dialog id="bc-diag-modal" class="bc-diagram-dialog">
    <div class="bc-dialog-header">
      <h3>Peta Alur Kerja Ekosistem Business Central (Ukuran Penuh)</h3>
      <button type="button" id="bc-close-diag-btn" class="bc-dialog-close-btn" aria-label="Tutup">✕ Tutup</button>
    </div>
    <div class="bc-dialog-body" id="bc-dialog-target"></div>
  </dialog>
</figure>

<script>
  import Panzoom from '@panzoom/panzoom';

  const svg = document.querySelector<SVGElement>('.bc-ecosystem-svg');
  const zoomInBtn = document.getElementById('bc-zoom-in');
  const zoomOutBtn = document.getElementById('bc-zoom-out');
  const zoomResetBtn = document.getElementById('bc-zoom-reset');

  if (svg) {
    const panzoom = Panzoom(svg, {
      maxScale: 4,
      minScale: 0.8,
      contain: 'outside',
    });

    svg.parentElement?.addEventListener('wheel', panzoom.zoomWithWheel);
    zoomInBtn?.addEventListener('click', () => panzoom.zoomIn());
    zoomOutBtn?.addEventListener('click', () => panzoom.zoomOut());
    zoomResetBtn?.addEventListener('click', () => panzoom.reset());
  }

  const openBtn = document.getElementById('bc-open-diag-btn');
  const closeBtn = document.getElementById('bc-close-diag-btn');
  const modal = document.getElementById('bc-diag-modal') as HTMLDialogElement | null;
  const target = document.getElementById('bc-dialog-target');

  if (openBtn && closeBtn && modal && target && svg) {
    openBtn.addEventListener('click', () => {
      target.innerHTML = '';
      const clone = svg.cloneNode(true) as SVGElement;
      target.appendChild(clone);
      modal.showModal();

      const modalPanzoom = Panzoom(clone, {
        maxScale: 5,
        minScale: 0.6,
      });
      clone.parentElement?.addEventListener('wheel', modalPanzoom.zoomWithWheel);
    });
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }
</script>

<style>
  .bc-ecosystem-diagram-wrapper {
    margin: var(--bc-space-4) 0;
    padding: var(--bc-space-4);
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-md);
    background: var(--bc-surface);
  }
  .bc-diagram-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--bc-space-2);
    margin-bottom: var(--bc-space-3);
    padding-bottom: var(--bc-space-2);
    border-bottom: var(--bc-border-width) solid var(--bc-border);
  }
  .bc-diagram-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--bc-space-1);
  }
  .bc-diagram-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    font-size: var(--bc-text-sm);
    font-weight: 600;
    color: var(--bc-text);
    background: var(--bc-surface-2);
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .bc-diagram-tool-btn:hover {
    border-color: var(--bc-accent);
    color: var(--bc-accent);
  }
  .bc-diagram-tag {
    font-size: var(--bc-text-xs);
    font-weight: 600;
    color: var(--bc-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .bc-diagram-expand-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--bc-space-1);
    font-size: var(--bc-text-xs);
    font-weight: 500;
    color: var(--bc-text);
    background: var(--bc-surface-2);
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .bc-diagram-expand-btn:hover {
    border-color: var(--bc-accent);
    color: var(--bc-accent);
  }
  .bc-ecosystem-diagram-viewport {
    width: 100%;
    overflow: hidden;
  }
  .bc-ecosystem-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--bc-font-sans);
  }
  .bc-node-rect {
    fill: var(--bc-surface-2);
    stroke: var(--bc-border);
    stroke-width: 1.5;
    transition: stroke 0.15s ease, fill 0.15s ease;
  }
  .bc-node-group:hover .bc-node-rect {
    stroke: var(--bc-accent);
  }
  .bc-node-title {
    font-size: 16px;
    font-weight: 700;
    fill: var(--bc-text);
  }
  .bc-node-subtitle {
    font-size: 13px;
    fill: var(--bc-text-muted);
  }
  .bc-node-subdetail {
    font-size: 12px;
    fill: var(--bc-text-muted);
  }
  .bc-node-badge {
    font-size: 12px;
    font-weight: 600;
    fill: var(--bc-accent);
  }
  .bc-flow-pill-text {
    font-size: 11px;
    font-weight: 600;
    fill: var(--bc-text);
  }
  .bc-ecosystem-caption {
    margin-top: var(--bc-space-3);
    text-align: center;
    font-size: var(--bc-text-xs);
    color: var(--bc-text-muted);
  }

  /* Modal Dialog */
  .bc-diagram-dialog {
    width: 90vw;
    max-width: 1200px;
    border: var(--bc-border-width) solid var(--bc-border);
    border-radius: var(--bc-radius-lg);
    background: var(--bc-surface);
    color: var(--bc-text);
    padding: var(--bc-space-4);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }
  .bc-diagram-dialog::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }
  .bc-dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: var(--bc-border-width) solid var(--bc-border);
    padding-bottom: var(--bc-space-3);
    margin-bottom: var(--bc-space-3);
  }
  .bc-dialog-header h3 {
    margin: 0;
    font-size: 1.125rem;
  }
  .bc-dialog-close-btn {
    background: var(--bc-surface-2);
    border: var(--bc-border-width) solid var(--bc-border);
    color: var(--bc-text);
    padding: 6px 14px;
    border-radius: var(--bc-radius-sm);
    cursor: pointer;
    font-size: var(--bc-text-xs);
  }
  .bc-dialog-close-btn:hover {
    border-color: var(--bc-danger);
    color: var(--bc-danger);
  }
  .bc-dialog-body {
    padding: var(--bc-space-2) 0;
    max-height: 80vh;
    overflow: auto;
  }
</style>
