---
import '../styles/learning-flow.css';

interface Props {
  videoId?: string;
  title?: string;
  description?: string;
  source?: string;
}

const {
  videoId = '37d3ec2a-71c2-4f0d-9a94-62c83805fbfa',
  title = 'Membuat customer',
  description = 'Prasyarat sebelum membuat dokumen penjualan.',
  source = 'https://learn.microsoft.com/en-us/dynamics365/business-central/quick-start-sell-products-and-services#set-up-customers',
} = Astro.props;
const player = new URL('https://learn-video.azurefd.net/vod/player');
player.searchParams.set('id', videoId);
---
<bc-reference-video class="bc-reference-video" data-player={player.href} data-title={`Microsoft Learn: ${title}`}>
  <p><strong>{title}</strong> — {description}</p>
  <button type="button" hidden>Muat video Microsoft Learn</button>
  <div class="bc-video-slot"></div>
  <p><a href={source}>buka sumber Microsoft Learn</a></p>
</bc-reference-video>
<script>
  class ReferenceVideo extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('button');
      const slot = this.querySelector('.bc-video-slot');
      if (!button || !slot || !this.dataset.player || slot.firstElementChild || !button.hidden) return;
      button.hidden = false;
      button.addEventListener('click', () => {
        const frame = document.createElement('iframe');
        frame.src = this.dataset.player!;
        frame.title = this.dataset.title!;
        frame.allowFullscreen = true;
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        slot.append(frame);
        button.hidden = true;
        frame.focus();
      }, { once: true });
    }
  }
  if (!customElements.get('bc-reference-video')) customElements.define('bc-reference-video', ReferenceVideo);
</script>
